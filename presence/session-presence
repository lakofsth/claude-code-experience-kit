#!/usr/bin/env python3
"""Presence registry and peer-note inbox for concurrent Claude Code sessions.

WHY. Several sessions run on one host at once and cannot see each other. On 2026-08-08 that
cost four concrete collisions in one evening: one session left uncommitted work in a shared
tree that another nearly merged over; one re-analysed a defect the other already had a fix
for; one published while the other held unpublished commits; one amended a commit that had
already been mirrored. Every one of those was a fact that already existed on the machine with
no path between the two processes -- a person carried each of them across by hand.

WHAT THIS IS. Two halves of one mechanism:

  presence -- each session records id, cwd, model and the trees it has written to, refreshed
  on the tool-call path that already fires. That alone answers "is anyone else in here", and
  warns before a write into a tree another live session is working in.

  inbox -- `agent-send` leaves a note for a peer session; the note is delivered on that
  session's next tool call.

THE TRUST RULE, which the code enforces rather than describes: the human operator carries
authority, the inbox carries attention. A note may POINT AT a durable record; it may not
CONTAIN the instruction. So a `directive` note is refused unless it names one, and every
delivery is labelled as a peer claim that a session may act on defensively but may not take
new work from. Without that split, arriving promptly becomes a way to acquire authority that
was never granted.

HONEST BOUND ON DELIVERY. There is no push. A session acts only when invoked, so a note
lands on the recipient's next tool call -- seconds for a session that is working, never for
one sitting idle at a prompt. That is the right shape for the problem: the collisions happen
precisely when both sessions are busy.

HONEST BOUND ON "AUTHORIZED". Every session here runs as the same uid. Anything that can
write the inbox can write any tree it can reach. This is coordination hygiene between
cooperating processes, not a security control, and the word "authorized" above must not be
read as one.

THE OTHER REGISTRY. Claude Code keeps its own session registry (~/.claude/sessions/<pid>.json)
and names the same sessions differently there -- a name built from the directory the session
was STARTED in plus a random suffix, say `alice-5e`, rather than `autumn-spruce` -- and that is
the name its built-in ListAgents/SendMessage use. Neither registry mentioned the other until
2026-08-10, when a session read a presence name out of this tool's own injection, tried to
reply, and found it was not an address anywhere. Both sides key on the session id, so every
surface here now prints both names, and tells a session its OWN -- you cannot sign a message
with a name you were never told.

Subcommands: register / pretool / end are hook entry points and are silent on any error --
a hook that breaks a tool call is worse than no hook. list / send are the human CLIs
(installed as `agent-presence` and `agent-send`) and report errors normally.
"""
import fcntl
import hashlib
import json
import os
import re
import shutil
import sys
import time
import uuid

LIVE_WINDOW = 1800      # 30 min since last tool call: still "live" for listing and delivery
TREE_WINDOW = 1800      # 30 min since another session wrote in a tree: worth warning about
WARN_COOLDOWN = 900     # 15 min: warn once per (peer, tree), not on every Edit
SKEW_COOLDOWN = 6 * 3600     # the stale-build warning repeats at most this often per session
REAP_AFTER = 3 * 86400  # records and read notes older than this are removed
MAX_TREES = 24          # cap the per-record tree map so it cannot grow without bound
MAX_RENDER = 8          # cap peers/notes named in ONE injection; the rest are counted, not listed
NAME_PROBES = 64        # rehashes tried before a name falls back to a numeric suffix
# A name returns to the pool this long after it was issued. SIZED, not picked: measured
# against the live mapping on 2026-08-26, holding every row for 14 days leaves 286 of the 1024
# pairs free today, against roughly 17 names/day once minting is deferred to the first tool
# call -- about 240 in flight in the steady state. Holding for 30 days instead would have left
# 119 free and nothing cooling until 2026-09-08, so the pool would have run dry in the gap and
# handed out suffixes for about six days. Raise it once that backlog has cooled; the ceiling is
# (free pairs) / (names per day), and `agent-presence --names | wc -l` measures the numerator.
NAME_COOLDOWN = 14 * 86400

WRITE_TOOLS = {"Edit", "Write", "MultiEdit", "NotebookEdit"}

# A path argument: double-quoted, single-quoted, or a bare token. Bare stops at whitespace and
# shell separators, which is why an unquoted path containing a space cannot be handled at all --
# and why the quoted forms have to be, since `cd "/tmp/my project"` truncated to `"/tmp/my` used
# to resolve to /tmp and record a bogus, very broad tree key.
_PATH = r"""(?:"(?P<{0}d>[^"]+)"|'(?P<{0}s>[^']+)'|(?P<{0}b>[^\s;&|]+))"""

# Bash commands that mutate a git working tree. `fetch` is deliberately NOT here: it moves refs
# and leaves the working tree alone, so it cannot collide with a peer's uncommitted work, and
# including it would add noise without adding a warning anyone needs.
GIT_MUTATOR = re.compile(
    r"\bgit\s+(?:-C\s+" + _PATH.format("c") + r"\s+)?(?:-\S+\s+)*"
    r"(?:commit|push|pull|merge|rebase|reset|checkout|switch|cherry-pick|revert|am|apply|tag"
    r"|stash|clean|rm|restore|worktree|submodule)\b"
)


def _path_group(m, prefix):
    """The path a _PATH group matched, whichever quoting form it took."""
    if not m:
        return None
    for suffix in ("d", "s", "b"):
        val = m.group(f"{prefix}{suffix}")
        if val:
            return val
    return None

# `cd X && git commit` is a habitual shape, and the payload's cwd is the SESSION's
# directory -- it does not follow a cd inside the command. Without this, such a
# commit is recorded against the wrong tree AND the tree it actually wrote is missed, which
# is worse than not recording it: the warning then fires for the wrong pair.
CD_IN_COMMAND = re.compile(r"(?:^|&&|;|\|\|)\s*cd\s+" + _PATH.format("x"))


def does_not_reach():
    """What the write-detection deliberately does not cover, so a caller is not misled.

    Named rather than implied: a guard on one axis makes the whole question look settled.

      - Bash writes that are not git: redirections, sed -i, cp, mv, installers, make.
      - `git fetch`, on purpose: it moves refs without touching the working tree, so it cannot
        collide with a peer's uncommitted work.
      - An UNQUOTED path containing a space (`cd /tmp/my project`). Quoted forms are handled;
        a bare one is indistinguishable from two arguments without a shell parser.
      - Shell variables and command substitution in a path (`cd "$REPO"`, `cd $(git root)`) --
        the value is not known without executing it, and a hook must not execute anything.
      - The record store, where one is configured (AGENT_PRESENCE_REF_DIR). EXCLUDED ON
        PURPOSE: a store of durable records is written constantly and append-only, so
        warning about it would be noise about a collision the design already handles. Point
        that variable at a note store, not at a code tree.
      - Any write by a process that is not a Claude Code session (a human shell, cron, a
        service). Those never appear in the registry at all.

    And one limit of the --ref pointer check, which is not write-detection but belongs with
    the honest list: a store is any directory at AGENT_PRESENCE_REF_DIR, with no check of
    what it actually is. Point that at some other directory holding a matching <name>.md and
    the pointer resolves. Left as-is deliberately: every structural marker that could be
    tested for (an index file, a .git) is a detail of one store's layout rather than its
    contract, so testing one would make a real store fail the check the day that layout
    changed -- a worse failure than the misconfiguration it would catch.
    """


# --------------------------------------------------------------------------- paths

def state_dir():
    # Overridable so the suite never writes the live registry (and so a test's failure
    # cannot delete a real session's record).
    d = os.environ.get("AGENT_PRESENCE_DIR") or os.path.expanduser(
        "~/.local/state/claude-sessions")
    return d


def claude_home():
    return os.environ.get("AGENT_PRESENCE_CLAUDE_HOME") or os.path.expanduser("~/.claude")


# Session names. Plain, concrete words: a name has to be sayable out loud in a sentence like
# "what is amber-heron doing in infra", and has to stay legible next to the others in a list.
#
# The pool is 32 x 32 = 1024 pairs, and the rate it is consumed at is the whole design problem.
# Measured 2026-08-26: 2163 names issued in 17 days, so the pool had lapped twice and 58% of all
# names carried a `-N` suffix. Three mechanisms hold it, and they are sized against each other --
# widening these two word lists would not have been a fix, only a longer treadmill.
ADJECTIVES = ("amber", "brisk", "calm", "clear", "copper", "dusk", "early", "fair", "green",
              "hollow", "idle", "keen", "level", "linen", "mellow", "north", "olive", "patient",
              "quiet", "rapid", "slate", "steady", "tidal", "umber", "vivid", "warm", "west",
              "willow", "winter", "autumn", "bright", "still")
NOUNS = ("alder", "badger", "beacon", "birch", "cedar", "crane", "delta", "ember", "falcon",
         "fern", "harbour", "hazel", "heron", "kestrel", "lantern", "linnet", "maple", "marten",
         "meadow", "otter", "pines", "quarry", "raven", "ridge", "rowan", "sable", "sorrel",
         "spruce", "thistle", "vale", "willet", "wren")


def name_cooldown():
    """How long a name stays out of the pool after it was issued.

    Overridable so the suite can drive the boundary without waiting thirty days, and so the
    period can be retuned from the environment if the session rate changes again.
    """
    try:
        return max(0, int(os.environ.get("AGENT_PRESENCE_NAME_COOLDOWN", "")))
    except ValueError:            # unset, empty, or not a number
        return NAME_COOLDOWN


def derive_name(sid, attempt=0):
    """The candidate name for a session id at probe number `attempt`.

    Deterministic in both arguments. `attempt=0` is the same arithmetic the first version of
    this file used, so every uncontended name ever issued is still recomputable from its id.

    Later attempts rehash the id rather than suffixing the attempt-0 name, which is what keeps
    a contended name a clean two-word pair. Note the bound, and note that the prose here has
    overstated it before: a name issued at attempt > 0 is not recoverable from the id ALONE,
    because which attempt won depended on what was taken at the time. It IS recoverable from
    (id, attempt), and the whole candidate sequence for an id is enumerable, so `names.tsv`
    stays the authority and this is a check rather than a derivation.
    """
    seed = (sid or "").encode() if not attempt else f"{sid or ''}#{attempt}".encode()
    h = hashlib.sha1(seed).digest()
    return f"{ADJECTIVES[h[0] % len(ADJECTIVES)]}-{NOUNS[h[1] % len(NOUNS)]}"


def names_file():
    return os.path.join(state_dir(), "names.tsv")


def read_name_rows():
    """Every row of the durable mapping, in file order, as (name, session_id, issued, cwd).

    This is the one reader of the file; the two views below are derived from it. Rows are
    never removed, so this is the record that answers "which session was amber-heron on the
    14th" -- and since a cooled name CAN be issued again, that question needs the date.
    """
    rows = []
    try:
        with open(names_file()) as fh:
            for line in fh:
                parts = line.rstrip("\n").split("\t")
                if len(parts) < 2 or not parts[0] or not parts[1]:
                    continue
                try:
                    issued = int(parts[2]) if len(parts) > 2 else 0
                except ValueError:
                    issued = 0
                rows.append((parts[0], parts[1], issued, parts[3] if len(parts) > 3 else ""))
    except OSError:
        pass
    return rows


def read_names(rows=None):
    """name -> the session id that holds it NOW. Newest row wins.

    This changed direction when reuse landed, and the change is the point: it used to be
    oldest-wins, because a name had exactly one holder for all time. It now answers "who is
    this name" and not "who was it ever" -- `read_name_rows()` answers the second.
    """
    out = {}
    for name, sid, _issued, _cwd in (read_name_rows() if rows is None else rows):
        out[name] = sid
    return out


def name_of_sid(rows=None):
    """session id -> the name it runs under. NEWEST row wins.

    Deliberately NOT derived from read_names(): once a name has been reissued, the earlier
    holder is no longer that name's current owner, and a session must still be recognisable
    under the name it ran as. This is the view the display path uses.

    A session usually has exactly one row. It can have two: idle past the cooldown, its name
    reissued to somebody else, and then it acts again and is minted a fresh one. The newest
    row is the name it is displayed under now, and the older row still answers the dated
    lookup for the window it held.
    """
    out = {}
    for name, sid, _issued, _cwd in (read_name_rows() if rows is None else rows):
        out[sid] = name
    return out


def taken_names(rows=None, now=None):
    """name -> holder, for every name that must not be issued to somebody else right now.

    Two sources, and the invariant binds both -- see tests/INVARIANTS.md,
    `name-uniqueness-among-the-reachable`:

      1. Mapping rows issued within name_cooldown(). Older rows have cooled and their names
         return to the pool; `names.tsv` still carries them, so the lookup they exist for is
         unharmed -- it just needs the date, which every citation of a name already carries.
      2. Every name a session RECORD currently holds, however old its row is. The mapping can
         be lost or truncated independently of the records, and a name in use by a live
         session must never be handed out because the file that recorded it went missing. A
         review reproduced two simultaneously-live sessions displaying one name; this is the
         second source that closed it, and the cooldown must not reopen it.
    """
    now = time.time() if now is None else now
    cool = name_cooldown()
    out = {}
    for name, sid, issued, _cwd in (read_name_rows() if rows is None else rows):
        if now - issued <= cool:
            out[name] = sid
    for rec in all_records():
        held = rec.get("name")
        if isinstance(held, str) and held:
            out[held] = rec.get("session_id")
    return out


def assign_name(sid, cwd=None):
    """This session's name, minted once and recorded for good.

    Called only from paths that mean a session needs a human-legible name -- see
    tests/INVARIANTS.md, `a-name-is-minted-only-for-a-session-that-acts`. The SessionStart
    path deliberately does NOT call it: 87% of records measured on 2026-08-26 belonged to
    `claude -p` one-shots that register, answer, and end without ever taking a tool call, and
    naming them was what emptied the pool.
    """
    os.makedirs(state_dir(), exist_ok=True)
    with open(names_file() + ".lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            rows = read_name_rows()
            mine = name_of_sid(rows).get(sid)
            # Only if nobody has been given it since. A session idle past the cooldown can
            # come back to find its name reissued; it is then a different session's name and
            # returning it here would put two live sessions under one.
            if mine and read_names(rows).get(mine) == sid:
                return mine
            taken = taken_names(rows)
            for attempt in range(NAME_PROBES):
                name = derive_name(sid, attempt)
                if name not in taken:
                    break
            else:
                # Every probe collided, which means the pool is effectively full. The numeric
                # suffix is kept for exactly this case and no other: a `-N` name is now the
                # LOUD signal that there are no free pairs left, rather than the ordinary
                # outcome of two ids hashing alike.
                base, n = derive_name(sid), 1
                name = base
                while name in taken:
                    n += 1
                    name = f"{base}-{n}"
            with open(names_file(), "a+") as fh:
                # A previous writer killed mid-write leaves a line with no newline; appending
                # after it FUSES two rows into one, and the older row's id becomes garbage --
                # which destroys exactly the lookup this file exists to answer. Repair first.
                fh.seek(0, os.SEEK_END)
                if fh.tell():
                    fh.seek(fh.tell() - 1)
                    if fh.read(1) != "\n":
                        fh.write("\n")
                # The cwd is payload text — the peer chose it, as it chose its session id —
                # and this file is the authority for who holds a name. Written raw, a cwd
                # carrying a newline and tabs appends a ROW of the peer's choosing (INVARIANTS.md,
                # `a-names-row-is-one-line-of-four-fields`). one_line() collapses every
                # whitespace run, tabs and newlines included, so the field stays a field.
                fh.write(f"{name}\t{sid}\t{int(time.time())}\t"
                         f"{one_line(cwd or '', MAX_PATH_RENDER)}\n")
            return name
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)


def name_for(sid, rec=None):
    """The display name for a session id: the record's, else the mapping's, else the id."""
    # Always a string, and bounded. A record's name field is not schema-checked anywhere, and
    # a non-string one used to raise TypeError inside a `+` in render_collision/cmd_register --
    # OUTSIDE any per-item guard, so the whole injection vanished silently and kept vanishing
    # for as long as the bad record existed. Coercing here removes the fault at its root
    # rather than at the three places that concatenate it. Found by review.
    if rec and rec.get("name"):
        return one_line(rec["name"], 40)
    mine = name_of_sid().get(sid)
    if mine:
        return one_line(mine, 40)
    return short(sid)


def record_path(sid):
    return os.path.join(state_dir(), "sessions", f"{sid}.json")


def lock_path(sid):
    """The touch lock, deliberately NOT in sessions/.

    It lived beside the record until reap()'s sweep of that directory deleted it -- reap
    unlinks anything there that does not parse as a record, and an empty lock file never
    does. Unlinking a held lock is legal, and the next opener then creates a FRESH inode
    whose flock does not block on the old one, so mutual exclusion silently stopped meaning
    anything and the lost update the lock was written to close came back. Found by review.
    """
    return os.path.join(state_dir(), "locks", f"{sid}.lock")


def inbox_dir(sid):
    return os.path.join(state_dir(), "inbox", sid)


def ensure_dirs():
    for sub in ("sessions", "inbox", "warn", "locks"):
        os.makedirs(os.path.join(state_dir(), sub), exist_ok=True)


def atomic_write(path, obj):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.tmp.{os.getpid()}"
    with open(tmp, "w") as fh:
        json.dump(obj, fh)
    os.replace(tmp, path)


# --------------------------------------------------------------------------- registry

def read_record(path):
    try:
        with open(path) as fh:
            rec = json.load(fh)
    except Exception:
        return None
    return rec if isinstance(rec, dict) and rec.get("session_id") else None


def all_records():
    out = []
    d = os.path.join(state_dir(), "sessions")
    try:
        names = sorted(os.listdir(d))
    except OSError:
        return out
    for name in names:
        if not name.endswith(".json"):
            continue
        rec = read_record(os.path.join(d, name))
        if rec:
            out.append(rec)
    return out


def is_live(rec, now=None):
    now = now if now is not None else time.time()
    return (now - float(rec.get("last_seen") or 0)) <= LIVE_WINDOW


def peers(sid, now=None):
    return [r for r in all_records() if r.get("session_id") != sid and is_live(r, now)]


def model_for(sid):
    """The model actually serving that session, or None.

    Read from the marker the clock heartbeat already maintains rather than re-parsing the
    transcript on every tool call. If it is absent the model is simply OMITTED -- a wrong
    model claim is worse than none, and this file is the only cheap source of truth.
    """
    try:
        with open(os.path.join(claude_home(), f".lastmodel.{sid}")) as fh:
            val = fh.read().strip()
    except Exception:
        return None
    return val if val.startswith("claude-") else None


def messaging_names(now=None):
    """session_id -> the name Claude Code's OWN messaging layer answers to, for LIVE processes.

    THE SEAM THIS SITS ON. Two registries name the same sessions and neither mentions the
    other: this tool's (presence names like `autumn-spruce`, keyed by session id) and the
    harness's own (`~/.claude/sessions/<pid>.json`, whose names are what ListAgents/SendMessage
    use and are NOT a function of the session id -- they are built from the directory the
    session was started in plus a random suffix, so nothing here can compute one). On
    2026-08-10 that cost a real delivery -- a session read the presence names out of this very
    injection, tried to reply, and found that none of them resolved as an address. The join key
    is the session id, which both sides already carry.

    Read-only, and deliberately shallow: only `sessionId` and `name` are consumed, so a
    harness upgrade that adds or renames anything else cannot break this. Every failure is
    fail-OPEN -- the annotation disappears and the injection still renders -- because this
    surface is the one that tells a session its peers exist, and losing it wholesale to a
    schema change would be far worse than losing one label.

    Dead processes are excluded, so a name here is a name something is listening to. That
    also keeps the ambiguity check below honest: a stale file must not make a live session
    look ambiguous.
    """
    out, seen = {}, {}
    try:
        d = os.path.join(claude_home(), "sessions")
        names = sorted(os.listdir(d))
    except OSError:
        return {}
    # A live session can hold no messaging socket at all -- observed on this host on
    # 2026-08-10, persistently, on a session that was working at the time. Such a session is
    # NOT reachable by SendMessage and IS reachable by agent-send, so the name is still worth
    # printing (it is how you recognise a message from it) but printing it as though it were
    # an address would recreate the exact dead end this change exists to remove.
    for fname in names:
        if not fname.endswith(".json"):
            continue
        # Per-record guard: one unreadable record must not cost every other session its
        # label. An unguarded loop here would be an outage for everything behind the bad row.
        try:
            with open(os.path.join(d, fname)) as fh:
                rec = json.load(fh)
            if not isinstance(rec, dict):
                continue
            sid, name = rec.get("sessionId"), rec.get("name")
            if not isinstance(sid, str) or not isinstance(name, str) or not sid or not name:
                continue
            if not process_alive(rec.get("pid"), rec.get("procStart")):
                continue
            sock = rec.get("messagingSocketPath")
            out[sid] = {"name": one_line(name, 40),
                        "reachable": bool(sock) and os.path.exists(sock),
                        "version": rec.get("version")}
            seen.setdefault(out[sid]["name"], []).append(sid)
        except Exception:
            continue
    # A name shared by two live sessions is not an address. Saying so is the honest output;
    # printing one of them would misroute silently, which is the failure this whole change
    # exists to remove.
    for name, owners in seen.items():
        if len(owners) > 1:
            for sid in owners:
                out[sid]["name"] = None
    return out


def process_alive(pid, proc_start=None):
    """Is that pid running, and is it still the SAME process?

    A pid on its own is a stale claim waiting to happen: pids are reused, and these records
    outlive the sessions that wrote them. The harness stores the kernel's start-time for the
    process, so compare it when it is there -- that is what makes a recycled pid legible as a
    different process rather than as the session that used to hold it.
    """
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return False
    if pid <= 0 or not os.path.exists(f"/proc/{pid}"):
        return False
    if proc_start is None:
        return True
    try:
        with open(f"/proc/{pid}/stat") as fh:
            # The comm field can contain spaces and parentheses; everything after the LAST
            # ')' is positional, and starttime is field 22 overall = index 19 after it.
            fields = fh.read().rsplit(")", 1)[1].split()
        return fields[19] == str(proc_start)
    except Exception:
        # Cannot tell (no procfs, permissions, a shape we do not know) -- fall back to the
        # weaker pid check rather than dropping a session that is probably fine.
        return True


def parse_version(v):
    """(2, 1, 226) from "2.1.226", or None.

    Compared as NUMBERS, never as strings: "2.1.99" sorts above "2.1.226" lexically, so a
    string compare would call a genuinely old session current for the whole of a 100-release
    stretch, silently, which is the failure mode this check exists to end.
    """
    if not isinstance(v, str):
        return None
    parts = v.strip().split(".")
    if len(parts) < 2 or not all(p.isdigit() for p in parts):
        return None
    return tuple(int(p) for p in parts)


def installed_cli_version():
    """The version of the Claude Code installed ON DISK right now, or None.

    Read from the package manifest beside the binary that `claude` resolves to -- following the
    symlink, because the name on PATH is a link into the package and the package root is two
    levels up from `bin/`. No subprocess: this runs inside a SessionStart hook, and a hook that
    spawns a process is a hook that can hang a session start.

    Returns None rather than a guess whenever it cannot tell. That matters more than usual
    here: silence costs a warning nobody sees, while a wrong answer either cries stale at a
    current session or, worse, certifies a stale one as current.
    """
    candidates = []
    try:
        found = shutil.which("claude")
        if found:
            real = os.path.realpath(found)
            candidates.append(os.path.join(os.path.dirname(os.path.dirname(real)),
                                           "package.json"))
    except Exception:
        pass
    candidates.append(os.path.expanduser(
        "~/.npm-global/lib/node_modules/@anthropic-ai/claude-code/package.json"))
    for path in candidates:
        try:
            with open(path) as fh:
                got = parse_version(json.load(fh).get("version"))
            if got:
                return got
        except Exception:
            continue
    return None


def fmt_version(t):
    return ".".join(str(n) for n in t)


def version_skew_note(sid, names=None):
    """A warning for a session whose process is older than what is installed, or None.

    WHY THIS EXISTS. `/clear` starts a new conversation inside the SAME process, so a session
    can be cleared any number of times and still be executing the binary it started with --
    even after that binary has been deleted from disk by an upgrade. Nothing about such a
    session looks wrong. On 2026-08-10 one had been running for ten days across many clears,
    silently missing cross-session messaging, and it surfaced only because something went
    looking for a socket it could not have.

    Addressed to the affected session itself, because it is the only party that can act. It is
    emitted from the PreToolUse hook, NOT from SessionStart, and that distinction is the whole
    of defect D284: naming the right audience is not reaching it. `/clear` starts a new
    conversation in the same process, so a long-lived process reaches SessionStart only when it
    is cleared -- and the population this warning is about is exactly the population that has
    been cleared least. Measured four and a half hours after the warning first shipped, its own
    founding case had been in conversation for seven hours and could never have been told. A
    tool call is the event a live session does reach.
    """
    names = messaging_names() if names is None else names
    entry = names.get(sid) or {}
    running = parse_version(entry.get("version"))
    installed = installed_cli_version()
    if not running or not installed or running >= installed:
        return None
    fmt = fmt_version
    note = (f"THIS SESSION IS RUNNING CLAUDE CODE {fmt(running)}, BUT {fmt(installed)} IS "
            f"INSTALLED. `/clear` starts a new conversation in the same process, so clearing "
            f"will never pick the new build up — only quitting this process and starting a "
            f"fresh one will. Anything added since {fmt(running)} is simply absent here, and "
            f"absent quietly: nothing else about the session looks wrong.")
    if not entry.get("reachable"):
        note += (" One consequence is already visible — this session advertises no messaging "
                 "socket, so peers cannot reach it with SendMessage and must use `agent-send`.")
    return note


def messaging_label(sid, names=None):
    """The ` = <messaging-name>` suffix for a session id, or a note that it has none."""
    names = messaging_names() if names is None else names
    if sid not in names:
        return ""
    entry = names[sid]
    if entry["name"] is None:
        return " [messaging name is ambiguous — ask ListAgents]"
    if not entry["reachable"]:
        return f" = {entry['name']} (no SendMessage socket — reach it with agent-send)"
    return f" = {entry['name']}"


def touch(sid, cwd=None, tree=None, started=None, mint=False):
    """Refresh this session's own record, under an exclusive lock.

    A session writes only its OWN file, but that is not the same as having one writer: the
    harness dispatches parallel tool calls within a single turn, so two `pretool` hooks for
    the same session run concurrently, and a plain read-modify-write loses one of them. That
    was reproduced against this code -- two concurrent touches recording different trees left
    only the second. The lock is on a sidecar file so it never competes with the atomic
    replace of the record itself.
    """
    now = time.time()
    path = record_path(sid)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    lock_file = lock_path(sid)
    os.makedirs(os.path.dirname(lock_file), exist_ok=True)
    with open(lock_file, "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            return _touch_locked(sid, path, now, cwd, tree, started, mint)
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)


def _touch_locked(sid, path, now, cwd, tree, started, mint=False):
    rec = read_record(path) or {
        "session_id": sid,
        "started": started if started is not None else now,
        "trees": {},
    }
    rec["last_seen"] = now
    # Only when the caller says this session needs a name. Registering does not; taking a tool
    # call does. See tests/INVARIANTS.md, `a-name-is-minted-only-for-a-session-that-acts`.
    if mint and not rec.get("name"):
        rec["name"] = assign_name(sid, cwd)
    if cwd:
        rec["cwd"] = cwd
    model = model_for(sid)
    if model:
        rec["model"] = model
    if tree:
        trees = rec.get("trees") or {}
        trees[tree] = now
        if len(trees) > MAX_TREES:
            trees = dict(sorted(trees.items(), key=lambda kv: kv[1], reverse=True)[:MAX_TREES])
        rec["trees"] = trees
    atomic_write(path, rec)
    return rec


def reap(now=None):
    now = now if now is not None else time.time()
    d = os.path.join(state_dir(), "sessions")
    try:
        names = os.listdir(d)
    except OSError:
        names = []
    live_sids = set()
    for name in names:
        # Only records. Every other listing site filters on .json; this one did not, which is
        # how it came to delete the touch locks.
        if not name.endswith(".json"):
            continue
        p = os.path.join(d, name)
        rec = read_record(p)
        if rec is None or (now - float(rec.get("last_seen") or 0)) > REAP_AFTER:
            try:
                os.unlink(p)
            except OSError:
                pass
        else:
            live_sids.add(rec["session_id"])
    # A lock is removed only when its session has no record at all AND the lock is itself old.
    # A session that still exists keeps its lock however long it has been idle, so this can
    # never pull the lock out from under a running touch().
    ldir = os.path.join(state_dir(), "locks")
    for name in os.listdir(ldir) if os.path.isdir(ldir) else []:
        if not name.endswith(".lock") or name[:-5] in live_sids:
            continue
        p = os.path.join(ldir, name)
        try:
            if now - os.path.getmtime(p) > REAP_AFTER:
                os.unlink(p)
        except OSError:
            pass
    # Warning-cooldown markers age out too. They were the one state directory nothing swept:
    # a marker is minted per (session, peer, tree) and per (session, version-skew, build), and
    # sessions are ephemeral, so the set only ever grew -- 167 files were standing when this
    # was found. REAP_AFTER is far longer than either cooldown, so reaping can never cut one
    # short; the worst a removed marker can do is allow one duplicate warning.
    wdir = os.path.join(state_dir(), "warn")
    for name in os.listdir(wdir) if os.path.isdir(wdir) else []:
        p = os.path.join(wdir, name)
        try:
            if now - os.path.getmtime(p) > REAP_AFTER:
                os.unlink(p)
        except OSError:
            pass
    # Both delivered AND undelivered notes age out. Undelivered ones used to be exempt, which
    # meant every broadcast to a session that then ended left a file nothing would ever remove
    # -- unbounded growth, since cmd_end unlinks the record but not the inbox.
    # The bus legs, swept by their own function next door because they are a different shape:
    # two flat directories of records, not a tree of per-session inboxes. Called from here so
    # the bus is bounded by the thing that already runs, rather than by a caller remembering.
    reap_bus(now=now, max_age=REAP_AFTER)
    for root, _dirs, files in os.walk(os.path.join(state_dir(), "inbox")):
        for f in files:
            if not f.endswith(".json"):
                continue
            p = os.path.join(root, f)
            try:
                if now - os.path.getmtime(p) > REAP_AFTER:
                    os.unlink(p)
            except OSError:
                pass


# --------------------------------------------------------------------------- trees

def tree_of(path):
    """The git toplevel containing path, else the containing directory.

    Walks for a .git entry rather than shelling out to git -- this runs on every write tool
    call, and os.path.exists catches both a repo's .git directory and a worktree's .git file.
    """
    # realpath, not abspath: two routes to one tree that differ by a symlink hop are the SAME
    # tree, and treating them as different silently disables collision detection for anyone
    # working through a symlinked checkout.
    p = os.path.realpath(os.path.expanduser(path))
    if not os.path.isdir(p):
        p = os.path.dirname(p)
    cur = p
    while True:
        if os.path.exists(os.path.join(cur, ".git")):
            return cur
        parent = os.path.dirname(cur)
        if parent == cur:
            return p
        cur = parent


def ref_store():
    """The directory of durable records a directive's pointer names, or None.

    OPTIONAL, and unset by default — this is the one seam where a session-continuity or
    note store plugs in. Point AGENT_PRESENCE_REF_DIR at a directory holding one `<name>.md`
    per topic and a directive's `--ref` is checked to resolve against it; leave it unset and
    a `--ref` is accepted as an opaque label. The coordination half of this tool needs no
    store at all.

    One consequence to know before pointing it anywhere: writes inside this directory are
    NOT collision-warned (see does_not_reach), on the assumption that a record store is
    append-only and merge-safe. Point it at a note store, not at a code tree.
    """
    d = os.environ.get("AGENT_PRESENCE_REF_DIR")
    return os.path.abspath(os.path.expanduser(d)) if d else None


def store_present():
    """Whether a record store is available on this machine at all.

    The store is OPTIONAL, so on a machine without one a --ref is accepted as an opaque label
    rather than refused. Where a store does exist, the pointer is checked — the useful half of
    the rule is that a directive's pointer RESOLVES, and that is only knowable when there is
    somewhere to look.
    """
    store = ref_store()
    return bool(store) and os.path.isdir(store)


def head_state(ref):
    """'ok' | 'missing' | 'unchecked' for a pointer to a durable record.

    Checked by looking for the FILE, not by running the store's own CLI. Measured 2026-08-09
    against one such tool: `show <topic>` exited 0 for a topic that does not exist, so a caller
    reading exit codes could not tell a missing topic from a present one — and a topic can also
    be withheld from some readers, where absence of output likewise does not mean absence of a
    record. The file is the thing itself; it also spawns no process on the send path.
    """
    if not ref:
        return "unchecked"
    if not store_present():
        return "unchecked"
    if "/" in ref or ref.startswith("."):
        return "missing"     # a pointer is a topic name, never a path out of the store
    return "ok" if os.path.isfile(os.path.join(ref_store(), f"{ref}.md")) else "missing"


def target_tree(tool_name, tool_input, cwd):
    """The tree this tool call is about to write to, or None if it is not a tracked write."""
    if tool_name in WRITE_TOOLS:
        target = (tool_input.get("file_path") or tool_input.get("notebook_path")
                  or tool_input.get("path") or "")
        if not target:
            return None
        tree = tree_of(target)
    elif tool_name == "Bash":
        command = tool_input.get("command") or ""
        m = GIT_MUTATOR.search(command)
        if not m:
            return None
        base = _path_group(m, "c")
        if not base:
            # The last cd that precedes the git call wins; an explicit -C always beats it.
            cds = [c for c in CD_IN_COMMAND.finditer(command) if c.start() < m.start()]
            base = _path_group(cds[-1], "x") if cds else (cwd or ".")
        if not base.startswith(("/", "~")) and cwd:
            base = os.path.join(cwd, base)
        tree = tree_of(base)
    else:
        return None
    # The merge-safe record store is excluded on purpose; see does_not_reach().
    if tree == ref_store():
        return None
    return tree


def collisions(sid, tree, now=None):
    """Live peers that wrote in this tree recently."""
    now = now if now is not None else time.time()
    out = []
    for rec in peers(sid, now):
        ts = (rec.get("trees") or {}).get(tree)
        if ts and (now - float(ts)) <= TREE_WINDOW:
            out.append((rec, now - float(ts)))
    return out


def _warn_marker(sid, other_sid, tree):
    # A STABLE digest, not hash(): str.__hash__ is salted per process, so every hook
    # invocation would compute a different marker name and the cooldown would never fire.
    # Caught by test_warning_is_throttled_per_peer_and_tree, which went red for exactly this.
    # The TREE must stay in the key: without it the per-tree throttle silently collapses into
    # a per-peer one, and a warning about one tree suppresses the next about a different one.
    key = f"{sid}.{other_sid}.{hashlib.sha1(tree.encode()).hexdigest()[:12]}"
    return os.path.join(state_dir(), "warn", key)


def warn_due(sid, other_sid, tree, now=None, cooldown=WARN_COOLDOWN):
    """Whether this subject is outside its cooldown. PURE CHECK -- records nothing.

    `cooldown` defaults to the collision period, so the peer-and-tree caller is unchanged. The
    stale-build warning passes its own: a collision is worth repeating every 15 minutes because
    the other session may have moved on, while a stale build is a standing condition only the
    person can clear, and 15-minute nagging over a ten-day session is 960 identical warnings.

    Splitting the decision from the record is the fix for a real defect: the marker used to be
    written here, at the moment of deciding, while the emit happens later and every hook path
    is deliberately fail-silent. Any error in between burned the cooldown for a warning the
    model never saw, suppressing the one genuine collision the tool exists to report for a
    further 15 minutes. Commit the cooldown with warn_commit(), after the emit has happened.
    """
    now = now if now is not None else time.time()
    try:
        return (now - os.path.getmtime(_warn_marker(sid, other_sid, tree))) >= cooldown
    except OSError:
        return True


def warn_commit(sid, other_sid, tree, now=None):
    """Record that the warning was actually delivered. Call only after a successful emit."""
    now = now if now is not None else time.time()
    p = _warn_marker(sid, other_sid, tree)
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p, "w") as fh:
        fh.write(str(int(now)))


# --------------------------------------------------------------------------- notes

VALID_CLASSES = ("advisory", "directive")


def write_note(to_sid, note):
    d = inbox_dir(to_sid)
    os.makedirs(d, exist_ok=True)
    # MICROseconds, zero-padded to a fixed width: delivery order is the sorted filename order,
    # and a whole-second prefix made every note sent within one second sort by its random uuid
    # instead of by when it was sent.
    name = f"{int(note['ts'] * 1_000_000):016d}-{uuid.uuid4().hex[:8]}.json"
    atomic_write(os.path.join(d, name), note)
    return os.path.join(d, name)


def pending_notes(sid):
    d = inbox_dir(sid)
    try:
        names = sorted(n for n in os.listdir(d) if n.endswith(".json"))
    except OSError:
        return []
    out = []
    for n in names:
        p = os.path.join(d, n)
        try:
            with open(p) as fh:
                note = json.load(fh)
        except Exception:
            continue
        out.append((p, note))
    return out


def claim_notes(sid):
    """Take ownership of pending notes by atomic rename BEFORE rendering them.

    Read-then-mark let two concurrent `pretool` hooks for one session both render the same note
    and both deliver it -- reproduced against this code. `os.rename` is atomic and the loser
    gets ENOENT, so exactly one caller can claim a note. The cost is the property the design
    already declares -- the inbox is allowed to be lossy -- but state it accurately: ANY
    failure between claiming and emitting drops the note, not only process death. A broken
    pipe on the final print is enough, and the note is not re-offered later. Corrected after
    a review demonstrated it by forcing emit() to raise.
    """
    d = inbox_dir(sid)
    read_dir = os.path.join(d, "read")
    try:
        names = sorted(n for n in os.listdir(d) if n.endswith(".json"))
    except OSError:
        return []
    try:
        os.makedirs(read_dir, exist_ok=True)
    except OSError:
        return []
    out = []
    for n in names:
        dst = os.path.join(read_dir, n)
        try:
            os.rename(os.path.join(d, n), dst)
        except OSError:
            continue  # another hook claimed it first
        try:
            with open(dst) as fh:
                out.append(json.load(fh))
        except Exception:
            continue
    return out


# --------------------------------------------------------------------------- the session bus

# The hosted half of inter-session traffic: a session running somewhere else (claude.ai, a
# hosted agent) writes a note into bus/in through a relay, and a local session picks it up here.
# The relay this was built against is the quintessence project's `busspool` writer; any writer
# that produces the fixture schema (tests/fixtures/bus/) is read the same way.
#
# THIS FILE CARRIES ITS OWN READER RATHER THAN IMPORTING `quintessence.busspool`, WHICH WROTE
# THE NOTES. That is a deliberate cost, paid for one reason: this program is a PreToolUse hook
# that runs before every tool call of every session on the host, and its import list is nine
# stdlib modules. An import reaching into another repo's deploy tree would make a missing,
# half-installed or broken checkout of that project break every tool call on the machine — a far
# worse failure than the schema drift the duplication risks. The two also ship by different
# mechanisms (a symlink here, a pinned /opt checkout there), so they could never be updated in
# one act anyway. What holds them together instead is a conformance test over fixtures the REAL
# writer produced: tests/fixtures/bus/, regenerated by tests/instruments/make-bus-fixtures.py.
BUS_LEGS = ("in", "out")
BUS_TRAFFIC_KINDS = ("note", "ask", "reply")
BUS_SEEN_CAP = 32          # ids remembered beyond the watermark; bounds the record's growth
MAX_BUS_EXCERPT = 400      # what one hosted note may occupy in an injection


def bus_dir():
    return os.path.join(state_dir(), "bus")


def bus_leg_dir(leg):
    return os.path.join(bus_dir(), leg)


def read_bus_records(leg):
    """Every readable record in a leg, oldest first, as `(id, record)`.

    A file that does not parse is SKIPPED, not raised on: one corrupt record — a kill mid-write,
    a hand-edit, a peer running an older build — must not deny this session every other note
    queued behind it, and this runs on the path that precedes every tool call.
    """
    d = bus_leg_dir(leg)
    out = []
    try:
        names = sorted(n for n in os.listdir(d) if n.endswith(".json"))
    except OSError:
        return out
    for n in names:
        try:
            with open(os.path.join(d, n)) as fh:
                rec = json.load(fh)
        except Exception:
            continue
        if isinstance(rec, dict):
            out.append((n[:-5], rec))
    return out


def bus_addressed_to_me(rec, sid, names=None):
    """Does this hosted note name this session?

    A hosted sender addresses by whatever `list_peers` showed it, which is the presence name;
    `*` is the broadcast. The session id and its short form are accepted too because a note
    composed from a transcript may carry either.
    """
    to = rec.get("to")
    if not isinstance(to, str) or not to:
        return False
    if to == "*":
        return True
    mine = {sid, short(sid)}
    n = name_for(sid)
    if n:
        mine.add(n)
    mn = (names or messaging_names()).get(sid)
    if mn:
        mine.add(mn)
    return to in mine


def bus_new_for(sid, rec, records):
    """The records this session has not already taken, newest-watermark logic.

    Ids sort in mint order, so a watermark answers this in one comparison. The exception it
    cannot answer alone is a note minted in the SAME SECOND as the watermark and landing after
    it: within one second ids order by their random half, so such a note can sort below a
    watermark this session has already passed. Those are caught by a bounded set of recently
    taken ids, consulted only for that same second — an older id absent from the set is treated
    as already seen, because re-delivering a note is worse than missing a straggler and the set
    is deliberately not a full history.
    """
    wm = rec.get("bus_seen_max") or ""
    seen = set(rec.get("bus_seen") or ())
    out = []
    for rid, r in records:
        if rid > wm:
            out.append((rid, r))
        elif wm and rid[:16] == wm[:16] and rid not in seen:
            out.append((rid, r))
    return out


def bus_note_to_local(rid, rec):
    """Turn a hosted record into the local note shape the inbox and renderer already handle.

    Reusing the local inbox rather than rendering straight from the bus is what buys the
    properties that path already has and this one would otherwise have to re-earn: claim by
    atomic rename, so two concurrent hooks cannot both deliver one note; per-note containment
    at render; and one reaper for delivered and undelivered alike.
    """
    origin = rec.get("origin") if isinstance(rec.get("origin"), dict) else {}
    return {
        "from": None,
        "from_label": rec.get("from"),
        "hosted": True,
        "bus_id": rid,
        "ts": rec.get("created") or 0,
        "class": rec.get("class"),
        "ref": rec.get("ref"),
        "kind": rec.get("kind"),
        "text": rec.get("text"),
        "origin_type": origin.get("type"),
        "origin_locator": origin.get("locator"),
        "origin_sources": origin.get("sources"),
    }


def bus_ingest(sid):
    """Move hosted notes addressed to this session into its own inbox. Returns how many.

    Under the session's own lock, and the watermark is written in the SAME critical section as
    the copy: a crash between the two would otherwise either lose a note or deliver it twice on
    the next call, and which of those you get would depend on the order of two unlocked writes.
    """
    records = [(rid, r) for rid, r in read_bus_records("in")
               if r.get("kind") in BUS_TRAFFIC_KINDS]
    if not records:
        return 0
    path = record_path(sid)
    taken = 0
    try:
        with open(lock_path(sid), "a+") as lf:
            fcntl.flock(lf.fileno(), fcntl.LOCK_EX)
            rec = read_record(path)
            if rec is None:
                return 0
            names = messaging_names()
            fresh = [(rid, r) for rid, r in bus_new_for(sid, rec, records)
                     if bus_addressed_to_me(r, sid, names)]
            if not fresh:
                return 0
            seen = list(rec.get("bus_seen") or ())
            for rid, r in fresh:
                try:
                    write_note(sid, bus_note_to_local(rid, r))
                except Exception:
                    continue    # one unwritable note must not cost the others
                seen.append(rid)
                taken += 1
            if not taken:
                return 0
            rec["bus_seen"] = seen[-BUS_SEEN_CAP:]
            rec["bus_seen_max"] = max([rid for rid, _r in fresh]
                                      + [rec.get("bus_seen_max") or ""])
            atomic_write(path, rec)
    except OSError:
        return 0
    return taken


def hosted_peers(now=None):
    """Hosted sessions that have announced a handle, newest first.

    They are records in the same leg as the traffic — the bus face may write exactly one
    directory, so its own bookkeeping goes where its notes go. LIVE_WINDOW is not applied: a
    hosted session gives no sign of being alive between calls, so the honest statement is when
    it announced itself, not whether it is still there.
    """
    now = time.time() if now is None else now
    out = {}
    for _rid, r in read_bus_records("in"):
        if r.get("kind") != "peer":
            continue
        h = r.get("handle")
        if isinstance(h, str) and h:
            out[h] = r.get("created") or 0
    return sorted(out.items(), key=lambda kv: kv[1], reverse=True)


def bus_write_out(note):
    """Write one note to the outbound leg, in the schema `quintessence.busspool` validates.

    The id scheme is busspool's and is duplicated here for the same reason the reader is: this
    program may not import it. It is pinned against the real writer's output by the conformance
    test rather than by inspection.
    """
    d = bus_leg_dir("out")
    os.makedirs(d, exist_ok=True)
    mid = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()) + "-" + uuid.uuid4().hex[:12]
    rec = dict(note)
    rec["id"] = mid
    rec.setdefault("created", time.time())
    atomic_write(os.path.join(d, mid + ".json"), rec)
    return mid


def reap_bus(now=None, max_age=None):
    """Age out both legs. Returns how many were removed.

    NOTHING ELSE SWEEPS THIS. `reap()` above enumerates four fixed subdirectories and does not
    walk the tree, so the bus would grow without limit exactly as `warn/` did — 167 files
    standing when that was found, and the undelivered-note exemption in the same reaper that
    made every broadcast to a since-ended session permanent. This is the third instance of that
    shape in this one directory, which is why it ships with the reader rather than after it.
    """
    now = time.time() if now is None else now
    max_age = REAP_AFTER if max_age is None else max_age
    removed = 0
    for leg in BUS_LEGS:
        d = bus_leg_dir(leg)
        try:
            names = os.listdir(d)
        except OSError:
            continue
        for name in names:
            p = os.path.join(d, name)
            try:
                if not os.path.isfile(p):
                    continue
                if now - os.path.getmtime(p) > max_age:
                    os.unlink(p)
                    removed += 1
            except OSError:
                pass
    return removed


def ago(seconds):
    seconds = int(seconds)
    if seconds < 90:
        return f"{seconds}s ago"
    if seconds < 5400:
        return f"{seconds // 60}m ago"
    return f"{seconds // 3600}h ago"


def short(sid):
    return (sid or "")[:8]


